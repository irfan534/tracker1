# ==============================================================================
# Tracker - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and update the values for your environment.
# Values marked with [SECRET] should be strong random strings in production.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Full Prisma connection string
DATABASE_URL="postgresql://tracker_user:your_secure_password@postgres:5432/tracker_db"

# Database password used by the postgres container [SECRET]
DB_PASSWORD="your_secure_password"

# Database name and user
DB_NAME="tracker_db"
DB_USER="tracker_user"

# ------------------------------------------------------------------------------
# 2. REDIS CONFIGURATION (Caching & Sessions)
# ------------------------------------------------------------------------------
REDIS_URL="redis://redis:6379"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Secret key for signing access tokens (min 32 chars) [SECRET]
JWT_SECRET="placeholder-change-this-in-production-very-important"

# Secret key for signing refresh tokens [SECRET]
JWT_REFRESH_SECRET="placeholder-change-this-in-production-very-important"

# Token expiration times
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Password hashing complexity
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# 4. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
# Node environment (development, production, test)
NODE_ENV="production"

# Port the backend API will listen on
APP_PORT=3001

# Authorized frontend origin for CORS
CORS_ORIGIN="http://localhost:3000"

# ------------------------------------------------------------------------------
# 5. FILE STORAGE & UPLOADS
# ------------------------------------------------------------------------------
# Maximum allowed file size for uploads (in bytes)
MAX_FILE_SIZE="104857600" # 100MB

# Path where uploaded files will be stored inside the container
UPLOAD_DIR="/app/uploads"
STORAGE_DIR="/app/storage"

# ------------------------------------------------------------------------------
# 6. INFRASTRUCTURE & LOGGING
# ------------------------------------------------------------------------------
# Minimum log level (debug, info, warn, error)
LOG_LEVEL="info"

# Interval for container health checks (ms)
HEALTH_CHECK_INTERVAL=30000

# ------------------------------------------------------------------------------
# 7. EMAIL CONFIGURATION (Optional - SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="noreply@tracker.local"
